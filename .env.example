# -----------------------------------------------------------------------------
# Core Supabase configuration (required)
# Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_.
# Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Invite-only signup (required)
# Use a long random value and share it only with members joining the group.
# Also disable "Allow new users to sign up" in the Supabase Auth dashboard.
# -----------------------------------------------------------------------------
GROUP_INVITE_CODE=replace-with-a-long-random-invite-code

# -----------------------------------------------------------------------------
# Scoring (optional)
# Omit this for current scoring v3. Set to 1 only for an intentional rollback.
# -----------------------------------------------------------------------------
# SCORING_VERSION=1

# -----------------------------------------------------------------------------
# Push notification reminders (optional unless testing/deploying reminders)
# Generate the VAPID pair with: npx web-push generate-vapid-keys
# CRON_SECRET should be a separate long random value.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
CRON_SECRET=your-long-random-cron-secret

# -----------------------------------------------------------------------------
# AI Weekly Hunter Report (optional)
# Server-only Groq key. Reports stay disabled until each user explicitly opts in.
# Model order may be overridden with a comma-separated list.
# -----------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
# GROQ_REPORT_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,openai/gpt-oss-120b
